{
  "project": {
    "name": "CtxRtr",
    "fullName": "CtxRtr - Contextual Prompt Router",
    "description": "A versioned, validated, and audited Contextual Prompt Router, plus the environment-optimization tooling that keeps it running well on constrained hardware (a 2015 MacBook Pro).",
    "version": "1.0.0",
    "contact_name": "simien",
    "license": "MIT",
    "author": "simien",
    "maintainer": "simien",
    "website": "https://github.com/simien/CtxRtr",
    "documentation": "https://github.com/simien/CtxRtr#readme",
    "email": "",
    "githubUser": "simien",
    "repository": "simien/CtxRtr"
  },
  "system": {
    "targetOS": "macOS 12.7.6 Monterey",
    "targetHardware": "MacBook Pro (Retina, 15-inch, Mid 2015)",
    "performanceTargets": {
      "memory": {
        "target": "< 80%",
        "current": "34%",
        "status": "excellent"
      },
      "cpu": {
        "target": "< 70%",
        "current": "14%",
        "status": "optimal"
      },
      "disk": {
        "target": "< 85%",
        "current": "21%",
        "status": "healthy"
      },
      "swap": {
        "target": "minimal",
        "current": "0%",
        "status": "perfect"
      }
    }
  },
  "features": {
    "systemOptimization": {
      "enabled": true,
      "description": "Cursor IDE, Docker, and system performance tuning"
    },
    "pdfManagement": {
      "enabled": true,
      "description": "Automated PDF to markdown conversion with file watching"
    },
    "metricsTracking": {
      "enabled": true,
      "description": "Visual dashboards showing before/after improvements"
    },
    "healthMonitoring": {
      "enabled": true,
      "description": "Real-time system performance and health checks"
    },
    "automatedMaintenance": {
      "enabled": true,
      "description": "Cleanup scripts and optimization tools"
    },
    "securitySanitization": {
      "enabled": true,
      "description": "Pre-release sanitizer for public releases"
    }
  },
